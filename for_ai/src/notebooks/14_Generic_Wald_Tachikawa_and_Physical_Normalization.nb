Sin[theta]/8];\nu0={1/H1[r],1/H2[r],1/H3[r]}; v0=omega0r[r] u0; \
aFromAnsatz=Table[u0[[i]] dtCov+v0[[i]] \
etaCov,{i,3}];\nfDDFromAnsatz=Table[Table[D[aFromAnsatz[[i,nu]],coords[[mu]]]\
-D[aFromAnsatz[[i,mu]],coords[[nu]]],{mu,dim},{nu,dim}],{i,3}]; \
fUUFromAnsatz=Table[Simplify[gInverseFromAnsatz.fDDFromAnsatz[[i]].gInverseFr\
omAnsatz],{i,3}];\nx0upFromAnsatz={warp[r]/H1[r],warp[r]/H2[r],warp[r]/H3[r]}\
; x0downFromAnsatz=Table[Simplify[1/(3 x0upFromAnsatz[[i]])],{i,3}]; \
lambda3={0,0,1}; lambdaXFromAnsatz=Simplify[lambda3.x0upFromAnsatz]; \
dFromAnsatz=Table[Simplify[3 lambda3[[i]] x0downFromAnsatz[[j]]-9/2 \
lambdaXFromAnsatz x0downFromAnsatz[[i]] \
x0downFromAnsatz[[j]]],{i,3},{j,3}];\nzeroTensorQ[array_]:=And@@(TrueQ[Cancel\
[Together[PowerExpand[TrigExpand[#]]]]===0]&/@Flatten[{array}]);\nruu4=ArrayR\
eshape[riem0PairUU,{5,5,5,5}]; \
rMix4=ArrayReshape[riem0RightRaised,{5,5,5,5}]; \
rMixFromUpper=Table[Sum[g0dd[[m,a]] g0dd[[n,b]] \
ruu4[[a,b,c,d]],{a,5},{b,5}],{m,5},{n,5},{c,5},{d,5}];\nderivedTensorChecks=<\
|\"Metric\"->zeroTensorQ[gFromAnsatz-g0dd],\"InverseMetric\"->zeroTensorQ[gIn\
verseFromAnsatz-g0uu],\"VolumeDensity\"->zeroTensorQ[sdetFromAnsatz-sdet0],\"\
GaugePotentials\"->zeroTensorQ[aFromAnsatz-a0Vec],\"RaisedFieldStrengths\"->z\
eroTensorQ[fUUFromAnsatz-f0uu],\"lambdaDotX\"->zeroTensorQ[lambdaXFromAnsatz-\
lambdaX0],\"D_IJ\"->zeroTensorQ[dFromAnsatz-d0coef],\"MixedIndexRiemann\"->ze\
roTensorQ[rMixFromUpper-rMix4]|>; derivedTensorChecks"], "Input"], 
  Cell["Expected exact output:", "Text"], 
  Cell[BoxData["<|\"Metric\" -> True, \"InverseMetric\" -> True, \
\"VolumeDensity\" -> True, \"GaugePotentials\" -> True, \
\"RaisedFieldStrengths\" -> True, \"lambdaDotX\" -> True, \"D_IJ\" -> True, \
\"MixedIndexRiemann\" -> True|>"], "Output"], 
  Cell["3. Generalized Komar tensor and four-order stabilization", 
   "Section"], Cell["For an angular Killing field with vanishing boundary \
contraction i_phi A, the relevant kernel is P nabla xi - 2 xi nabla P. The \
covariant sector contains 2(lambda.X)R^(abcd)+D_IJ F_I^(ab)F_J^(cd). The \
mixed sector is the differentiated A^3 wedge R wedge R term. Each \
pair-symmetric double two-form is projected by subtracting its totally \
antisymmetric four-form component.", "Text"], 
  Cell[BoxData["z = zz;\n\nrunAtOrder[n_Integer] := Module[\n  {ser, dr, g, \
gu, ga, sd, a3, ruu, rMix, fuu, lx, dij,\n   pCovPair, pArrPair, pCov, pArr, \
pTot, pEH,\n   xiDown, nablaXi, divP, divCov, divArr, qFirst, qDiv, qDensity, \
qSeries,\n   qCovDensity, qArrDensity, qCovSeries, qArrSeries, nondecaying,\n \
  finiteCoefficient, thetaReduced, angularDerivativeSeries,\n   \
ehDensitySeries, ehFinite, report, eps},\n\n  Print[\"ORDER_START=\", n];\n  \
Clear[ser, ruu, rMix, fuu, pCovPair, pArrPair, pCov, pArr, pTot, pEH];\n  \
ser[expr_] := ser[expr] = Quiet @ Normal @ Series[\n      PowerExpand[expr /. \
r -> 1/z], {z, 0, n}];\n  dr[expr_] := Expand[-z^2 D[expr, z]];\n\n  g = \
Map[ser, g0dd, {2}];\n  gu = Map[ser, g0uu, {2}];\n  ga = Map[ser, gamma0Udd, \
{3}];\n  sd = ser[sdet0];\n  eps = Normal[LeviCivitaTensor[5]];\n  a3 = \
Map[ser, a0Vec[[3]]];\n  lx = ser[lambdaX0];\n  dij = Map[ser, d0coef, \
{2}];\n  ruu[a_, b_, c_, d_] := ruu[a, b, c, d] = If[a === b || c === d, 0,\n \
   ser[ArrayReshape[riem0PairUU, {5, 5, 5, 5}][[a, b, c, d]]]];\n  rMix[a_, \
b_, c_, d_] := rMix[a, b, c, d] = If[a === b || c === d, 0,\n    \
ser[ArrayReshape[riem0RightRaised, {5, 5, 5, 5}][[a, b, c, d]]]];\n  fuu[i_, \
a_, b_] := fuu[i, a, b] = If[a === b, 0, ser[f0uu[[i, a, b]]]];\n\n  (* \
CP-even curvature dependence:\n       lambda.X Riemann^2 + D_IJ Riemann F^I \
F^J. *)\n  pCovPair[a_, b_, c_, d_] := pCovPair[a, b, c, d] = If[a === b || c \
=== d, 0,\n    ser[2 lx ruu[a, b, c, d] +\n      1/2 Sum[dij[[i, j]] (\n      \
  fuu[i, a, b] fuu[j, c, d] + fuu[i, c, d] fuu[j, a, b]),\n        {i, 3}, \
{j, 3}]]];\n\n  (* Mixed A^3 wedge R wedge R contribution, with the \
pair-symmetrized\n     Riemann derivative used in the existing equal-charge \
audit. *)\n  pArrPair[a_, b_, c_, d_] := pArrPair[a, b, c, d] = If[a === b || \
c === d, 0,\n    ser[1/(2 sd) Sum[a3[[al]] (\n       eps[[a, b, rr, ss, al]] \
rMix[rr, ss, c, d] +\n       eps[[c, d, rr, ss, al]] rMix[rr, ss, a, b]),\n   \
    {rr, 5}, {ss, 5}, {al, 5}]]];\n\n  (* Eq. (3.28) requires the algebraic \
Riemann symmetries.  A pair-symmetric\n     double two-form is projected by \
removing its totally antisymmetric\n     four-form component. *)\n  pCov[a_, \
b_, c_, d_] := pCov[a, b, c, d] = ser[\n    pCovPair[a, b, c, d] - 1/3 \
(pCovPair[a, b, c, d] +\n      pCovPair[a, c, d, b] + pCovPair[a, d, b, \
c])];\n  pArr[a_, b_, c_, d_] := pArr[a, b, c, d] = ser[\n    pArrPair[a, b, \
c, d] - 1/3 (pArrPair[a, b, c, d] +\n      pArrPair[a, c, d, b] + pArrPair[a, \
d, b, c])];\n  pTot[a_, b_, c_, d_] := pTot[a, b, c, d] = ser[pCov[a, b, c, \
d] + pArr[a, b, c, d]];\n  pEH[a_, b_, c_, d_] := pEH[a, b, c, d] = ser[\n    \
1/2 (gu[[a, c]] gu[[b, d]] - gu[[a, d]] gu[[b, c]])];\n\n  xiDown = g[[All, \
5]];\n  nablaXi[rho_, s_] := nablaXi[rho, s] = ser[\n    Which[rho === 2, \
dr[xiDown[[s]]], rho === 3, D[xiDown[[s]], theta], True, 0]\n      - \
Sum[ga[[aa, s, rho]] xiDown[[aa]], {aa, 5}]];\n\n  divP[s_] := divP[s] = \
ser[Sum[\n    Which[rho === 2, dr[pTot[1, 2, rho, s]],\n          rho === 3, \
D[pTot[1, 2, rho, s], theta], True, 0]\n      + Sum[\n          ga[[1, aa, \
rho]] pTot[aa, 2, rho, s]\n        + ga[[2, aa, rho]] pTot[1, aa, rho, s]\n   \
     + ga[[rho, aa, rho]] pTot[1, 2, aa, s]\n        + ga[[s, aa, rho]] \
pTot[1, 2, rho, aa], {aa, 5}],\n    {rho, 5}]];\n  divCov[s_] := divCov[s] = \
ser[Sum[\n    Which[rho === 2, dr[pCov[1, 2, rho, s]],\n          rho === 3, \
D[pCov[1, 2, rho, s], theta], True, 0]\n      + Sum[\n          ga[[1, aa, \
rho]] pCov[aa, 2, rho, s]\n        + ga[[2, aa, rho]] pCov[1, aa, rho, s]\n   \
     + ga[[rho, aa, rho]] pCov[1, 2, aa, s]\n        + ga[[s, aa, rho]] \
pCov[1, 2, rho, aa], {aa, 5}],\n    {rho, 5}]];\n  divArr[s_] := divArr[s] = \
ser[Sum[\n    Which[rho === 2, dr[pArr[1, 2, rho, s]],\n          rho === 3, \
D[pArr[1, 2, rho, s], theta], True, 0]\n      + Sum[\n          ga[[1, aa, \
rho]] pArr[aa, 2, rho, s]\n        + ga[[2, aa, rho]] pArr[1, aa, rho, s]\n   \
     + ga[[rho, aa, rho]] pArr[1, 2, aa, s]\n        + ga[[s, aa, rho]] \
pArr[1, 2, rho, aa], {aa, 5}],\n    {rho, 5}]];\n\n  (* The \
single-(t,r)-component kernel after the -1/2 prefactor in Eq. (3.44)\n     is \
P nabla xi - 2 xi nabla P.  The omitted common factor from summing\n     the \
antisymmetric (t,r) and (r,t) components cannot affect the zero test. *)\n  \
qFirst = ser[Sum[pTot[1, 2, rho, s] nablaXi[rho, s], {rho, 5}, {s, 5}]];\n  \
qDiv = ser[-2 Sum[xiDown[[s]] divP[s], {s, 5}]];\n  qDensity = ser[sd (qFirst \
+ qDiv)];\n  angularDerivativeSeries = ser[D[Together[qDensity/Sin[theta]], \
theta]];\n  thetaReduced = Together[qDensity/Sin[theta] /. theta -> Pi/2];\n  \
qSeries = Collect[Expand[thetaReduced], z];\n  qCovDensity = ser[sd \
(Sum[pCov[1, 2, rho, s] nablaXi[rho, s],\n      {rho, 5}, {s, 5}] - 2 \
Sum[xiDown[[s]] divCov[s], {s, 5}])];\n  qArrDensity = ser[sd (Sum[pArr[1, 2, \
rho, s] nablaXi[rho, s],\n      {rho, 5}, {s, 5}] - 2 Sum[xiDown[[s]] \
divArr[s], {s, 5}])];\n  qCovSeries = \
Collect[Expand[Together[qCovDensity/Sin[theta] /. theta -> Pi/2]], z];\n  \
qArrSeries = Collect[Expand[Together[qArrDensity/Sin[theta] /. theta -> \
Pi/2]], z];\n  (* The factor two sums the antisymmetric (t,r) and (r,t) \
components.\n     With the standard angular ranges, coefficient jrot/4 \
reproduces\n     J_1=J_2=Pi jrot/(4 G5). *)\n  ehDensitySeries = \
Collect[Expand[Together[\n    2 sd Sum[pEH[1, 2, rho, s] nablaXi[rho, s], \
{rho, 5}, {s, 5}]/\n      Sin[theta] /. theta -> Pi/2]], z];\n  ehFinite = \
Coefficient[ehDensitySeries, z, 0];\n  finiteCoefficient = \
Coefficient[qSeries, z, 0];\n  nondecaying = Association@Table[ToString[k] -> \
Coefficient[qSeries, z, k],\n    {k, -12, 0}];\n\n  report = <|\n    \
\"SeriesOrder\" -> n,\n    \"FiniteDensityCoefficient\" -> \
finiteCoefficient,\n    \"FiniteDensityCoefficientZero\" -> \
TrueQ[Cancel[Together[finiteCoefficient]] === 0],\n    \
\"AllPotentiallyNondecayingCoefficientsZero\" ->\n      And @@ \
(TrueQ[Cancel[Together[#]] === 0] & /@ Values[nondecaying]),\n    \
\"ReducedDensityAngularIndependent\" ->\n      \
TrueQ[Cancel[Together[angularDerivativeSeries]] === 0],\n    \
\"ReducedDensityAngularDerivativeSeries\" -> angularDerivativeSeries,\n    \
\"NondecayingCoefficientLedger\" -> nondecaying,\n    \"CoefficientZ4\" -> \
Coefficient[qSeries, z, 4],\n    \"CovariantFiniteCoefficient\" -> \
Coefficient[qCovSeries, z, 0],\n    \"MixedARRFiniteCoefficient\" -> \
Coefficient[qArrSeries, z, 0],\n    \"EinsteinKomarFiniteCoefficient\" -> \
ehFinite,\n    \"EinsteinKomarNormalizationPass\" -> TrueQ[ehFinite === \
jrot/4],\n    \"CovariantReducedDensityAngularDerivative\" ->\n      \
ser[D[Together[qCovDensity/Sin[theta]], theta]],\n    \
\"MixedARRReducedDensityAngularDerivative\" ->\n      \
ser[D[Together[qArrDensity/Sin[theta]], theta]],\n    \
\"DensitySeriesAtEquator\" -> qSeries,\n    \
\"CovariantCurvatureSectorSeries\" -> qCovSeries,\n    \
\"MixedARRSectorSeries\" -> qArrSeries,\n    \"PNablaXiPieceSeries\" -> \
ser[sd qFirst/Sin[theta] /. theta -> Pi/2],\n    \"DivergencePieceSeries\" -> \
ser[sd qDiv/Sin[theta] /. theta -> Pi/2]\n  |>;\n  Print[\"ORDER_RESULT=\", \
InputForm[KeyTake[report,\n    {\"SeriesOrder\", \
\"FiniteDensityCoefficientZero\",\n     \
\"AllPotentiallyNondecayingCoefficientsZero\",\n     \
\"ReducedDensityAngularIndependent\", \"CoefficientZ4\",\n     \
\"CovariantFiniteCoefficient\", \"MixedARRFiniteCoefficient\",\n     \
\"EinsteinKomarNormalizationPass\"}]]];\n  report\n];\n\nresults = \
Association@Table[ToString[n] -> runAtOrder[n], {n, orders}];\nfinitePass = \
And @@ Lookup[Values[results], \
\"FiniteDensityCoefficientZero\"];\nnondecayingPass = And @@ \
Lookup[Values[results], \
\"AllPotentiallyNondecayingCoefficientsZero\"];\nangularPass = And @@ \
Lookup[Values[results], \"ReducedDensityAngularIndependent\"];\neinsteinPass \
= And @@ Lookup[Values[results], \
\"EinsteinKomarNormalizationPass\"];\nstabilized = SameQ @@ \
(Lookup[Values[results], \"CoefficientZ4\"]);\nfinal = <|\n  \
\"FormulaReference\" -> \"Cassani-Ruiperez-Turetta arXiv:2304.06101 Eq. \
(3.44)\",\n  \"Sector\" -> \"generic q1,q2,q3 lambda3 curvature plus mixed \
ARR\",\n  \"Orders\" -> orders,\n  \"FiniteCoefficientZeroAtEveryOrder\" -> \
finitePass,\n  \"AllPotentiallyNondecayingCoefficientsZero\" -> \
nondecayingPass,\n  \"ReducedDensityAngularIndependentAtEveryOrder\" -> \
angularPass,\n  \"EinsteinKomarNormalizationAtEveryOrder\" -> einsteinPass,\n \
 \"LeadingCoefficientZ4Stabilized\" -> stabilized,\n  \"Results\" -> \
results,\n  \"PASS\" -> TrueQ[finitePass && nondecayingPass && angularPass \
&&\n    einsteinPass && stabilized]\n|>;\n"], "Input"], 
  Cell[BoxData["compactResults=Map[KeyTake[#,{\"SeriesOrder\",\"FiniteDensity\
CoefficientZero\",\"AllPotentiallyNondecayingCoefficientsZero\",\"ReducedDens\
ityAngularIndependent\",\"CoefficientZ4\",\"CovariantFiniteCoefficient\",\"Mi\
xedARRFiniteCoefficient\",\"EinsteinKomarFiniteCoefficient\",\"EinsteinKomarN\
ormalizationPass\"}]&,final[\"Results\"]]; \
computedCompact=<|\"FormulaReference\"->final[\"FormulaReference\"],\"Sector\
\"->final[\"Sector\"],\"Orders\"->final[\"Orders\"],\"FiniteCoefficientZeroAt\
EveryOrder\"->final[\"FiniteCoefficientZeroAtEveryOrder\"],\"AllPotentiallyNo\
ndecayingCoefficientsZero\"->final[\"AllPotentiallyNondecayingCoefficientsZer\
o\"],\"ReducedDensityAngularIndependentAtEveryOrder\"->final[\"ReducedDensity\
AngularIndependentAtEveryOrder\"],\"EinsteinKomarNormalizationAtEveryOrder\"-\
>final[\"EinsteinKomarNormalizationAtEveryOrder\"],\"LeadingCoefficientZ4Stab\
ilized\"->final[\"LeadingCoefficientZ4Stabilized\"],\"PASS\"->final[\"PASS\"]\
,\"Results\"->compactResults|>; expectedCompact=<|\"FormulaReference\" -> \
\"Cassani-Ruiperez-Turetta arXiv:2304.06101 Eq. (3.44)\", \"Sector\" -> \
\"generic q1,q2,q3 lambda3 curvature plus mixed ARR\", \"Orders\" -> {10, 12, \
14, 16}, \"FiniteCoefficientZeroAtEveryOrder\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependentAtEveryOrder\" -> True, \
\"EinsteinKomarNormalizationAtEveryOrder\" -> True, \
\"LeadingCoefficientZ4Stabilized\" -> True, \"PASS\" -> True, \"Results\" -> \
<|\"10\" -> <|\"SeriesOrder\" -> 10, \"FiniteDensityCoefficientZero\" -> \
True, \"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>, \"12\" -> \
<|\"SeriesOrder\" -> 12, \"FiniteDensityCoefficientZero\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>, \"14\" -> \
<|\"SeriesOrder\" -> 14, \"FiniteDensityCoefficientZero\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>, \"16\" -> \
<|\"SeriesOrder\" -> 16, \"FiniteDensityCoefficientZero\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>|>|>; \
waldCompactPass=TrueQ[computedCompact===expectedCompact]; computedCompact"], 
   "Input"], Cell["Expected exact compact certificate:", "Text"], 
  Cell[BoxData["<|\"FormulaReference\" -> \"Cassani-Ruiperez-Turetta \
arXiv:2304.06101 Eq. (3.44)\", \"Sector\" -> \"generic q1,q2,q3 lambda3 \
curvature plus mixed ARR\", \"Orders\" -> {10, 12, 14, 16}, \
\"FiniteCoefficientZeroAtEveryOrder\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependentAtEveryOrder\" -> True, \
\"EinsteinKomarNormalizationAtEveryOrder\" -> True, \
\"LeadingCoefficientZ4Stabilized\" -> True, \"PASS\" -> True, \"Results\" -> \
<|\"10\" -> <|\"SeriesOrder\" -> 10, \"FiniteDensityCoefficientZero\" -> \
True, \"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>, \"12\" -> \
<|\"SeriesOrder\" -> 12, \"FiniteDensityCoefficientZero\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>, \"14\" -> \
<|\"SeriesOrder\" -> 14, \"FiniteDensityCoefficientZero\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>, \"16\" -> \
<|\"SeriesOrder\" -> 16, \"FiniteDensityCoefficientZero\" -> True, \
\"AllPotentiallyNondecayingCoefficientsZero\" -> True, \
\"ReducedDensityAngularIndependent\" -> True, \"CoefficientZ4\" -> -2*jrot*q1 \
- 2*jrot*q2 - 8*jrot*q3, \"CovariantFiniteCoefficient\" -> 0, \
\"MixedARRFiniteCoefficient\" -> 0, \"EinsteinKomarFiniteCoefficient\" -> \
jrot/4, \"EinsteinKomarNormalizationPass\" -> True|>|>|>"], "Output"], 
  Cell["4. Exact particular-solution tails", "Section"], 
  Cell[BoxData["exactSolution=<|\"Gauge\" -> \"dhr=0; areal x=r^2; fixed Page \
charges; fixed physical J\", \"OrderInLambda3\" -> 1, \"RotationDependence\" \
-> \"exact finite polynomial through jrot^3\", \"U1\" -> \
(8*(-12*q1^3*q2^3*q3^2 + 2*q1^3*q2^3*q3*x - 28*q1^3*q2^2*q3^2*x - \
16*q1^2*q2^3*q3^2*x + 4*q1^3*q2^3*x^2 + 13*q1^3*q2^2*q3*x^2 + \
17*q1^2*q2^3*q3*x^2 - 27*q1^3*q2*q3^2*x^2 - 32*q1^2*q2^2*q3^2*x^2 - \
5*q1*q2^3*q3^2*x^2 + 12*q1^3*q2^2*x^3 + 12*q1^2*q2^3*x^3 + 8*q1^3*q2*q3*x^3 + \
62*q1^2*q2^2*q3*x^3 + 14*q1*q2^3*q3*x^3 - 10*q1^3*q3^2*x^3 - \
32*q1^2*q2*q3^2*x^3 - 8*q1*q2^2*q3^2*x^3 + 2*q2^3*q3^2*x^3 + 7*q1^3*q2*x^4 + \
34*q1^2*q2^2*x^4 + 7*q1*q2^3*x^4 - q1^3*q3*x^4 + 47*q1^2*q2*q3*x^4 + \
41*q1*q2^2*q3*x^4 + 5*q2^3*q3*x^4 - 13*q1^2*q3^2*x^4 - 12*q1*q2*q3^2*x^4 + \
5*q2^2*q3^2*x^4 + 22*q1^2*q2*x^5 + 16*q1*q2^2*x^5 + 2*q2^3*x^5 + \
8*q1^2*q3*x^5 + 24*q1*q2*q3*x^5 + 10*q2^2*q3*x^5 - 6*q1*q3^2*x^5 + \
2*q2*q3^2*x^5 + 3*q1^2*x^6 + 6*q1*q2*x^6 + 3*q2^2*x^6 + 3*q1*q3*x^6 + \
3*q2*q3*x^6))/(3*(q1 + x)^3*(q2 + x)^2*(q3 + x)^2*(q1*q2 + q1*q3 + q2*q3 + \
2*q1*x + 2*q2*x + 2*q3*x + 3*x^2)) - (16*jrot^2*(3*q1*q2*q3 + (4*q1*q2 + \
4*q1*q3 + q2*q3)*x + (5*q1 + 2*q2 + 2*q3)*x^2 + 3*x^3))/((q1 + x)^2*(q2 + \
x)*(q3 + x)^2*((q1 + x)*(q2 + x) + (q1 + x)*(q3 + x) + (q2 + x)*(q3 + x))), \
\"U2\" -> (8*(-12*q1^3*q2^3*q3^2 + 2*q1^3*q2^3*q3*x - 16*q1^3*q2^2*q3^2*x - \
