Notebook[{Cell["Corrected postdual scalar-map certificate", "Title"], 
  Cell["Generic static proof and five exact-in-r rotating samples", 
   "Subtitle"], Cell["Purpose and evidence boundary", "Section"], 
  Cell["This notebook corrects one coefficient in the second postdual scalar \
field redefinition.  It proves the generic static identity symbolically and \
records five independent rotating rational-parameter certificates exact as \
functions of r.  The rotating evidence is deliberately not called a symbolic \
proof for arbitrary charges.  The metric and sigma checks are unaffected.  \
The correction does not alter the predual three-form inversion, so it does \
not resolve the separate rotating C3 obstruction.", "Text"], 
  Cell["Correct field-redefinition stage", "Section"], 
  Cell["Inside the displayed second postdual scalar redefinition, add +(1/8) \
Exp[-8 varphi/3] Fminus^2 before multiplying the entire Delta2 expression by \
alphaPrime/8.  Equivalently, the Fminus^2 coefficient changes from -3/8 to \
-1/4, while the Fplus^2 coefficient remains -3/8.  The contribution to the \
coefficient of alphaPrime in the final scalar is therefore +Exp[-8 varphi/3] \
Fminus^2/64.  This term must not be inserted into a raw ten-dimensional \
profile or the torsion-free predual scalar.", "Text"], 
  Cell["Self-contained exact calculation", "Section"], 
  Cell[BoxData["(* Self-contained scalar-map consistency and repair \
certificate.\n   No cache, script, notebook, or target potential is imported. \
 The first\n   block proves the generic static identity symbolically.  The \
second block\n   stores the exact rational residual reconstructed in five \
rotating charge\n   samples and checks the covariant repair as an identity in \
r. *)\n\nClearAll[\"Global`*\"];\n$HistoryLength = 0;\ncanonical[e_] := \
Factor[Cancel[Together[e]]];\n\n(* Generic static logarithmic-derivative \
proof. *)\nphiTF = -(ls^2 + 2 ld^2 - 10 l3^2)/(32 h3);\ndeltaPhi1 = l3^2/(32 \
h3);\ndeltaPhi2Displayed = (8 ls^2 + 6 ld^2 + 4 ls l3 - 31 l3^2)/(96 \
h3);\nphiFinalSol = (ls + l3)^2/(48 h3);\ndisplayedResidual = canonical[phiTF \
+ deltaPhi1 + deltaPhi2Displayed - phiFinalSol];\n(* Derive the weighted \
static Fminus square from the leading electric\n   component and inverse \
Einstein metric; do not assign the target identity. *)\n$Assumptions = \
hplusSym > 0 && hminusSym > 0 && h3 > 0 &&\n  Element[{ls, ld, l3, phiSym}, \
Reals];\nfminusRT = -ls/Sqrt[hplusSym hminusSym];\ngEttInverse = -Exp[4 \
phiSym/3] hplusSym hminusSym;\ngErrInverse = Exp[4 \
phiSym/3]/h3;\nfminusSquare = FullSimplify[2 fminusRT^2 gEttInverse \
gErrInverse];\nweightedFminusSquare = FullSimplify[\n  Exp[-8 phiSym/3] \
fminusSquare];\npostdualRepairAlpha = \
weightedFminusSquare/64;\ncorrectedResidual = canonical[displayedResidual + \
postdualRepairAlpha];\noldInsideDelta2Coefficient = \
-3/8;\ncorrectedInsideDelta2Coefficient = oldInsideDelta2Coefficient + \
1/8;\nstaticSymbolicLedger = <|\n  \"DisplayedResidualIsLsSquaredOver32H3\" \
->\n    PossibleZeroQ[canonical[displayedResidual - ls^2/(32 h3)]],\n  \
\"WeightedFminusIdentity\" ->\n    \
PossibleZeroQ[canonical[weightedFminusSquare + 2 ls^2/h3]],\n  \
\"CorrectedFinalScalar\" -> PossibleZeroQ[correctedResidual],\n  \
\"CorrectedFminusCoefficientIsMinusOneQuarter\" ->\n    \
correctedInsideDelta2Coefficient == -1/4|>;\n\n(* Exact three-way static \
normalization at (qminus,qplus,qzero)=(3,5,7).\n   Notebook 11 stores the \
coefficient of lambda3; lambda3=alphaPrime/8. *)\nhm = 1 + 3/r^2; hp = 1 + \
5/r^2; h0 = 1 + 7/r^2;\nphi0 = Log[h0^2/(hp hm)]/4;\ntargetPLambda = 2 \
(10484775 + 13649370 r^2 + 7236821 r^4 +\n    1988796 r^6 + 296833 r^8 + \
22602 r^10 + 675 r^12)/\n  (3 (3 + r^2)^2 (5 + r^2)^2 (7 + r^2)^3\n    (71 + \
30 r^2 + 3 r^4));\nxiAlpha = -2 (33075 + 33915 r^2 + 12873 r^4 + 2121 r^6 + \
128 r^8)/\n  (3 r (3 + r^2) (5 + r^2) (7 + r^2)^2\n    (71 + 30 r^2 + 3 \
r^4));\npublishedOldAlpha = (D[Log[hp hm h0], r])^2/(48 \
h0);\nlambda3OverAlphaPrime = 1/8;\ntargetAlphaFromLambda = \
canonical[lambda3OverAlphaPrime targetPLambda];\ntargetPulledToOldAlpha = \
canonical[targetAlphaFromLambda - xiAlpha D[phi0, r]];\nthreeWayStaticLedger \
= <|\n  \"Lambda3ToAlphaPrimeConventionApplied\" ->\n    \
PossibleZeroQ[canonical[targetAlphaFromLambda - targetPLambda/8]],\n  \
\"Notebook11POver8EqualsPublishedFinalSol\" ->\n    \
PossibleZeroQ[canonical[targetPulledToOldAlpha - publishedOldAlpha]],\n  \
\"AuditPointResidual\" ->\n    (canonical[(D[Log[hp hm], r])^2/(32 h0)] /. r \
-> 2) == 961/87318|>;\n\n(* Five exact-in-r rotating certificates.  The first \
is the original\n   audit point and the other four are independent rational \
samples.\n   This evidence is not labelled a symbolic arbitrary-charge proof. \
*)\nsamples = {{3, 5, 7, 1}, {2, 3, 5, 1}, {4, 7, 9, 2},\n  {1, 6, 8, 3/2}, \
{5, 8, 11, -2}};\nrotatingResidualFormula[qm_, qp_, q0_, aa_] :=\n  \
canonical[((qm + qp) r^2 + 2 qm qp)^2/\n    (8 (r^2 + qm)^2 (r^2 + qp)^2 (r^2 \
+ q0)) -\n    aa^2/((r^2 + qm) (r^2 + qp) (r^2 + q0)^2)];\ncoords = {t, r, \
theta, phi, psi};\ndOne[v_] := Table[D[v[[j]], coords[[i]]] - D[v[[i]], \
coords[[j]]],\n  {i, 5}, {j, 5}];\ntwoFormSquare[f_, inverseMetric_] := \
Sum[f[[mu, nu]]\n  inverseMetric[[mu, aa1]] inverseMetric[[nu, bb1]] f[[aa1, \
bb1]],\n  {mu, 5}, {nu, 5}, {aa1, 5}, {bb1, \
5}];\nweightedFminusOver64FromLeadingFields[{qm_, qp_, q0_, aa_}] := \
Module[\n  {hminus, hplus, hzero, omega, thetaOne, coframe, metricString,\n   \
sigma0, phiLeading, avec, bvec, fminus, metricEinstein,\n   inverseEinstein, \
contraction},\n  hminus = 1 + qm/r^2; hplus = 1 + qp/r^2; hzero = 1 + \
q0/r^2;\n  omega = aa/(2 r^2);\n  thetaOne = {1, 0, 0, omega Cos[theta], \
omega};\n  coframe = ConstantArray[0, {5, 5}];\n  coframe[[1]] = \
thetaOne/Sqrt[hplus hminus];\n  coframe[[2]] = {0, Sqrt[hzero], 0, 0, 0};\n  \
coframe[[3]] = {0, 0, Sqrt[hzero] r/2, 0, 0};\n  coframe[[4]] = {0, 0, 0, \
Sqrt[hzero] r Sin[theta]/2, 0};\n  coframe[[5]] = {0, 0, 0, Sqrt[hzero] r \
Cos[theta]/2,\n    Sqrt[hzero] r/2};\n  metricString = \
Transpose[coframe].DiagonalMatrix[{-1,1,1,1,1}].coframe;\n  sigma0 = \
Log[hplus/hminus]/2;\n  phiLeading = Log[hzero^2/(hplus hminus)]/4;\n  avec = \
thetaOne/hplus; bvec = -thetaOne/hminus;\n  fminus = Exp[sigma0] dOne[avec] - \
Exp[-sigma0] dOne[bvec];\n  metricEinstein = Exp[-4 phiLeading/3] \
metricString;\n  inverseEinstein = Inverse[metricEinstein];\n  contraction = \
Exp[-8 phiLeading/3]\n    twoFormSquare[fminus, inverseEinstein]/64;\n  \
FullSimplify[PowerExpand[contraction],\n    Assumptions -> r > 0 && 0 < theta \
< Pi]];\nrotatingCertificates = Association@Table[Module[{residual, \
repair},\n    residual = rotatingResidualFormula @@ s;\n    repair = \
canonical[weightedFminusOver64FromLeadingFields[s]];\n    s -> \
<|\"UncorrectedSourceMinusTarget\" -> residual,\n      \
\"PostdualFminusRepairOver64\" -> repair,\n      \"RepairThetaIndependent\" \
-> FreeQ[repair, theta],\n      \"CorrectedResidual\" -> canonical[residual + \
repair]|>],\n  {s, samples}];\noriginalSampleExpected = (1545 + 1049 r^2 + \
230 r^4 + 16 r^6)/\n  (2 (105 + 71 r^2 + 15 r^4 + r^6)^2);\nrotatingLedger = \
<|\n  \"OriginalResidualFormula\" -> PossibleZeroQ[canonical[\n    \
rotatingResidualFormula[3, 5, 7, 1] - originalSampleExpected]],\n  \
\"FiveCorrectedResidualsExactInR\" -> And @@\n    (PossibleZeroQ /@ \
Lookup[Values[rotatingCertificates], \"CorrectedResidual\"]),\n  \
\"FiveLeadingFieldContractionsThetaIndependent\" -> And @@\n    \
Lookup[Values[rotatingCertificates], \"RepairThetaIndependent\"],\n  \
\"SampleCount\" -> (Length[rotatingCertificates] == 5)|>;\n\nevidenceLevel = \
\"generic static symbolic proof plus five rotating rational-parameter \
certificates exact in r; no arbitrary-charge rotating symbolic proof \
claimed\";\nstageStatement = \"the repair is in the second postdual scalar \
map and is not inserted into the raw or predual scalar\";\nledger = \
Join[staticSymbolicLedger, threeWayStaticLedger, rotatingLedger];\nfinalPass \
= And @@ Values[ledger];\nPrint[\"STATIC_DISPLAYED_RESIDUAL = \", \
InputForm[displayedResidual]];\nPrint[\"POSTDUAL_REPAIR_ALPHA = \", \
InputForm[postdualRepairAlpha]];\nPrint[\"CORRECTED_INSIDE_DELTA2_FMINUS_COEF\
FICIENT = \", \
correctedInsideDelta2Coefficient];\nPrint[\"ROTATING_CERTIFICATES = \", \
InputForm[rotatingCertificates]];\nPrint[\"EVIDENCE_LEVEL = \", \
evidenceLevel];\nPrint[\"STAGE_STATEMENT = \", \
stageStatement];\nPrint[\"LEDGER = \", \
InputForm[ledger]];\nPrint[\"FINAL_PASS = \", finalPass];"], "Input"], 
  Cell["Expected result", "Section"], Cell["FINAL_PASS must be True.  The \
evidence string must retain the phrase no arbitrary-charge rotating symbolic \
proof claimed.", "Text"]}, WindowSize -> {1400, 900}, 
 StyleDefinitions -> "Default.nb"]
