ven\"->ConstantArray[0,9]|>; \
recordedClosureClasses=<|\"j4Even\"-><|\"u1\"->\"NONTRIVIAL_CANCELLATION\",\"\
u2\"->\"NONTRIVIAL_CANCELLATION\",\"u3\"->\"NONTRIVIAL_CANCELLATION\",\"p\"->\
