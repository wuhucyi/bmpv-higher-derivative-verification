}->ConstantArray[\"ABSENCE_ZERO_ZERO\",9]]|>; \
recordedClassCounts=Counts[Flatten[Values/@Values[recordedClosureClasses]]]; \
recordedClassPass=TrueQ[Keys@Select[recordedClosureClasses[\"j4Even\"],#===\"\
NONTRIVIAL_CANCELLATION\"&]==={\"u1\",\"u2\",\"u3\",\"p\",\"f\"}&&Lookup[reco\
