2322*q1*q2*q3^2*z^7 + 1212*q2^2*q3^2*z^7 + 488*q1*q3^3*z^7 + \n      \
488*q2*q3^3*z^7 - 16*q3^4*z^7 + 48*q1^3*z^8 - 132*q1^2*q2*z^8 - \n      \
132*q1*q2^2*z^8 + 48*q2^3*z^8 + 183*q1^2*q3*z^8 - 324*q1*q2*q3*z^8 + \n      \
