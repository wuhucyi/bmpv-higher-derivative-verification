45*q1^2*z^9 - 126*q1*q2*z^9 + 45*q2^2*z^9 + 9*q1*q3*z^9 + 9*q2*q3*z^9 + \n    \
  180*q3^2*z^9))/(9*z*(q1 + z)^2*(q2 + z)^2*(q3 + z)^3*\n     (q1*q2 + q1*q3 \
+ q2*q3 + 2*q1*z + 2*q2*z + 2*q3*z + 3*z^2)^2)], \n K -> Function[{z}, 0], Om \
-> Function[{z}, \
0]};\nembeddedSeedSHA256=\"938395c7cdc10379069f2a6a823e326655d2a9a777c41b2b8a\
4cf4e723e888aa\";\nseedFieldSymbols={U1,U2,U3,B1,B2,B3,P,S,Ft,Gr,K,Om};\nseed\
FieldNames={\"delta u_1\",\"delta u_2\",\"delta \
u_3\",\"beta_1\",\"beta_2\",\"beta_3\",\"delta varphi_1\",\"delta \
varphi_2\",\"delta F\",\"delta G\",\"delta K\",\"delta omega\"};"], "Input"], 
  Cell["5. Exact field-by-field map and inverse", "Section"], 
  Cell[TextData[{"The comparison is carried out directly in R, without \
replacing R squared by a new symbol.  Together clears exact rational \
denominators and Expand tests the numerator.  The inverse check starts from \
the embedded areal functions and recovers every paper-coordinate correction, \
including the nonzero sphere-size correction."}], "Text"], 
  Cell[BoxData["staticMapChecks=AssociationThread[seedFieldNames,MapThread[ex\
actZeroQ[#1-#2]&,{candidateArealCorrections,(#[R^2]/.staticArealSeedRules)&/@\
seedFieldSymbols}]];\nseedArealCorrections=(#[R^2]/.staticArealSeedRules)&/@s\
eedFieldSymbols;\npaperRecoveredFromSeed={Together[seedArealCorrections[[1]]-\
xiStatic[R] \
derivativeAt[U10,R]],Together[seedArealCorrections[[2]]-xiStatic[R] \
derivativeAt[U20,R]],Together[seedArealCorrections[[3]]-xiStatic[R] \
derivativeAt[U30,R]],seedArealCorrections[[4]],seedArealCorrections[[5]],seed\
ArealCorrections[[6]],Together[-4 \
seedArealCorrections[[7]]/Sqrt[6]-xiStatic[R] \
derivativeAt[Varphi10,R]],Together[Sqrt[2] \
seedArealCorrections[[8]]-xiStatic[R] \
derivativeAt[Varphi20,R]],Together[seedArealCorrections[[9]]-xiStatic[R] \
derivativeAt[F0,R]],Together[seedArealCorrections[[10]]-xiStatic[R] \
derivativeAt[G0,R]-derivativeAt[xiStatic,R]],seedArealCorrections[[11]],seedA\
realCorrections[[12]],Together[0-xiStatic[R] \
(derivativeAt[H0,R]+1/R)]};\npaperOriginalCorrections={deltaU1Paper[R],deltaU\
2Paper[R],deltaU3Paper[R],0,0,0,deltaVarphi1Paper[R],deltaVarphi2Paper[R],del\
taFPaper[R],deltaGPaper[R],0,0,deltaHPaper[R]};\ninverseMapFieldNames=Append[\
seedFieldNames,\"delta H (sphere \
size)\"];\ninverseMapChecks=AssociationThread[inverseMapFieldNames,MapThread[\
exactZeroQ[#1-#2]&, \
{paperRecoveredFromSeed,paperOriginalCorrections}]];\n<|\"PaperToAreal\"->sta\
ticMapChecks,\"ArealToPaper\"->inverseMapChecks,\"AllPass\"->TrueQ[And@@Value\
s[staticMapChecks]&&And@@Values[inverseMapChecks]]|>"], "Input"], 
  Cell["6. General first-order pullback, exact in rotation", "Section"], 
  Cell[TextData[{"For any cohomogeneity-one rotating background whose fields \
depend on R and jrot, the same coordinate change is a tensor pullback.  At \
first order in lambda3, delta T in the areal chart equals delta T in the \
paper chart plus the Lie derivative of the exact-in-j background along \
xiGeneral(R,jrot) partial_R.  The following direct Jacobian calculation \
proves this for a scalar, every covector component, and every covariant \
rank-two component.  No series expansion in jrot is performed.  For a \
differential form, the equivalent rule is delta F_areal = delta F_paper + \
Lie_xi F0 = delta F_paper + d(i_xi F0) + i_xi(dF0)."}], "Text"], 
  Cell[BoxData["dimension=5; radialIndex=2; \
newCoordinates={time,R,theta,phi1,phi2};\noldCoordinates={time,R+lambda3 \
xiGeneral[R,jrot],theta,phi1,phi2};\ncoordinateJacobian=Table[D[oldCoordinate\
s[[mu]],newCoordinates[[a]]],{mu,dimension},{a,dimension}];\ndirectScalar=Nor\
mal@Series[(scalar0[rho,jrot]+lambda3 \
deltaScalarPaper[rho,jrot])/.rho->oldCoordinates[[radialIndex]],{lambda3,0,1}\
];\nexpectedScalar=scalar0[R,jrot]+lambda3 \
(deltaScalarPaper[R,jrot]+xiGeneral[R,jrot] \
D[scalar0[R,jrot],R]);\ndirectCovector=Table[Normal@Series[Sum[coordinateJaco\
bian[[mu,a]] ((covector0[mu][rho,jrot]+lambda3 \
deltaCovectorPaper[mu][rho,jrot])/.rho->oldCoordinates[[radialIndex]]),{mu,di\
mension}],{lambda3,0,1}],{a,dimension}];\nexpectedCovector=Table[covector0[a]\
[R,jrot]+lambda3 (deltaCovectorPaper[a][R,jrot]+xiGeneral[R,jrot] \
D[covector0[a][R,jrot],R]+KroneckerDelta[a,radialIndex] \
D[xiGeneral[R,jrot],R] \
covector0[radialIndex][R,jrot]),{a,dimension}];\ndirectMetric=Table[Normal@Se\
ries[Sum[coordinateJacobian[[mu,a]] coordinateJacobian[[nu,b]] \
((metric0[mu,nu][rho,jrot]+lambda3 \
deltaMetricPaper[mu,nu][rho,jrot])/.rho->oldCoordinates[[radialIndex]]),{mu,d\
imension},{nu,dimension}],{lambda3,0,1}],{a,dimension},{b,dimension}];\nexpec\
tedMetric=Table[metric0[a,b][R,jrot]+lambda3 \
(deltaMetricPaper[a,b][R,jrot]+xiGeneral[R,jrot] \
D[metric0[a,b][R,jrot],R]+KroneckerDelta[a,radialIndex] \
D[xiGeneral[R,jrot],R] \
metric0[radialIndex,b][R,jrot]+KroneckerDelta[b,radialIndex] \
D[xiGeneral[R,jrot],R] \
metric0[a,radialIndex][R,jrot]),{a,dimension},{b,dimension}];\ngeneralPullbac\
kChecks=<|\"Scalar\"->exactZeroQ[directScalar-expectedScalar],\"CovectorAllCo\
mponents\"->And@@Flatten[MapThread[exactZeroQ[#1-#2]&, \
{directCovector,expectedCovector}]],\"MetricAllComponents\"->And@@Flatten[Map\
Thread[exactZeroQ[#1-#2]&, \
{directMetric,expectedMetric},2]],\"NoRotationExpansion\"->FreeQ[{directScala\
r,directCovector,directMetric},_SeriesData]|>;\ngeneralPullbackChecks"], 
   "Input"], Cell["7. Rotating-coordinate interpretation", "Section"], 
  Cell[TextData[{"Choosing xiGeneral(R,jrot) = xiStatic(R) and applying the \
inverse of this rule to the complete exact-in-j areal-gauge solution defines a paper-matched rotating \
radial coordinate: its jrot = 0 limit is exactly the published static \
coordinate.  This construction does not establish a unique fully isotropic \
rotating gauge.  A rotating isotropy condition would have to be stated \
separately, and different jrot-dependent radial shifts can agree in the \
static limit.  Thus the static map is a proved equivalence; the rotating \
paper-matched presentation is a valid coordinate choice but not a uniqueness \
theorem."}], "Text"], Cell["8. Final certificate", "Section"], 
  Cell[BoxData["v4CoordinateCertificateChecks=<|\"Coupling \
lambda3=alphaPrime/8\"->couplingNormalizationChecks,\"Published alphaPrime \
transcription\"->And@@Values[paperTranscriptionChecks],\"Coordinate \
gauge\"->And@@Values[coordinateGaugeChecks],\"Static paper to areal field \
map\"->And@@Values[staticMapChecks],\"Static inverse \
map\"->And@@Values[inverseMapChecks],\"General exact-in-j \
pullback\"->And@@Values[generalPullbackChecks]|>;\nv4CoordinateCertificatePas\
s=TrueQ[And@@Values[v4CoordinateCertificateChecks]];\nfinalPass=v4CoordinateC\
ertificatePass;\n<|\"Checks\"->v4CoordinateCertificateChecks,\"FinalPass\"->v\
4CoordinateCertificatePass|>"], "Input"], 
  Cell[TextData[
    {"Expected final result: every entry is True and FinalPass is True."}], 
   "Text"]}, WindowSize -> {1400, 900}, 
 WindowMargins -> {{Automatic, 0}, {Automatic, 0}}, Magnification -> 1., 
 StyleDefinitions -> "Default.nb"]
