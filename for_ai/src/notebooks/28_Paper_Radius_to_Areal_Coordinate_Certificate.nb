3597*q1^3*q2^2*q3^2*z^4 + 3597*q1^2*q2^3*q3^2*z^4 + \n      \
486*q1*q2^4*q3^2*z^4 + 79*q1^4*q3^3*z^4 + 1786*q1^3*q2*q3^3*z^4 + \n      \
4386*q1^2*q2^2*q3^3*z^4 + 1786*q1*q2^3*q3^3*z^4 + 79*q2^4*q3^3*z^4 + \n      \
q1^3*q3^4*z^4 + 147*q1^2*q2*q3^4*z^4 + 147*q1*q2^2*q3^4*z^4 + \n      \
q2^3*q3^4*z^4 - 39*q1^4*q2^2*z^5 - 78*q1^3*q2^3*z^5 - \n      \
