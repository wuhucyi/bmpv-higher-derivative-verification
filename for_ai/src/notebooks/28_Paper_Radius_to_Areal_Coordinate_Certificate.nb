45*q1^2*q2^3*q3*z^5 - 18*q1*q2^4*q3*z^5 + 153*q1^4*q3^2*z^5 + \n      \
2472*q1^3*q2*q3^2*z^5 + 5544*q1^2*q2^2*q3^2*z^5 + \n      \
2472*q1*q2^3*q3^2*z^5 + 153*q2^4*q3^2*z^5 + 501*q1^3*q3^3*z^5 + \n      \
2859*q1^2*q2*q3^3*z^5 + 2859*q1*q2^2*q3^3*z^5 + 501*q2^3*q3^3*z^5 - \n      \
24*q1*q2*q3^4*z^5 - 20*q1^4*q2*z^6 - 132*q1^3*q2^2*z^6 - \n      \
