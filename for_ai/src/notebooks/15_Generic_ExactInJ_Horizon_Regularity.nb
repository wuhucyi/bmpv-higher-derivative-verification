+ 62*q1^2*q2^2*q3*x^3 + 8*q1*q2^3*q3*x^3 + 2*q1^3*q3^2*x^3 - \
8*q1^2*q2*q3^2*x^3 - 32*q1*q2^2*q3^2*x^3 - 10*q2^3*q3^2*x^3 + 7*q1^3*q2*x^4 + \
