           Cell[CellGroupData[
             {Cell["3.1 Curvature-free vector-invariant regression", 
               "Subsection", ExpressionUUID -> 
                "86f0ff04-2f4d-4219-8664-214a1b34a995"], Cell["This is a \
diagnostic, not the gravity correction. On the BPS background the two \
independent STU vector invariants must vanish. The rotation-dependent dTheta \
contribution cancels in the differences of dressed field strengths.", "Text", 
               ExpressionUUID -> "e96eb4e7-5dfe-4e86-b3dc-a42103b07f6d"], 
              Cell[BoxData[RowBox[{RowBox[{"tFdd", "=", RowBox[{"Table", "[", 
                      RowBox[{RowBox[{"Simplify", "[", FractionBox[RowBox[
                          {"Fdd", "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], RowBox[{"Xup", 
                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}]], "]"}], ",", RowBox[
                         {"{", RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], 
                  ";", RowBox[{RowBox[{"vectorInvariantPair", "[", RowBox[
                       {"i_", ",", "j_", ",", "prefactor_"}], "]"}], ":=", 
                    RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {"Vdd", ",", "Vud", ",", "Vsq", ",", "Vfour", ",", 
                          "Pcov", ",", "Pcon", ",", "Psq", ",", "Vsqdd", ",", 
                          "mixed"}], "}"}], ",", RowBox[{RowBox[{"Vdd", "=", 
                          RowBox[{"Simplify", "[", RowBox[{RowBox[{"tFdd", 
                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], "-", RowBox[{"tFdd", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}]}], "]"}]}], ";", RowBox[
                          {"Vud", "=", RowBox[{"Simplify", "[", RowBox[
                          {"guu", ".", "Vdd"}], "]"}]}], ";", RowBox[{"Vsq", 
                          "=", RowBox[{"Simplify", "[", RowBox[{"-", RowBox[
                          {"Tr", "[", RowBox[{"Vud", ".", "Vud"}], "]"}]}], 
                          "]"}]}], ";", RowBox[{"Vfour", "=", RowBox[
                          {"Simplify", "[", RowBox[{"Tr", "[", RowBox[
                          {"MatrixPower", "[", RowBox[{"Vud", ",", "4"}], 
                          "]"}], "]"}], "]"}]}], ";", RowBox[{"Pcov", "=", 
                          RowBox[{"Table", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[PartialD]", RowBox[{"coords", 
                          "\[LeftDoubleBracket]", "mu", 
                          "\[RightDoubleBracket]"}]], RowBox[{"Log", "[", 
                          FractionBox[RowBox[{"Xup", "\[LeftDoubleBracket]", 
                          "i", "\[RightDoubleBracket]"}], RowBox[{"Xup", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}]], "]"}]}], ",", RowBox[
                          {"{", RowBox[{"mu", ",", "dim"}], "}"}]}], "]"}]}], 
                          ";", RowBox[{"Pcon", "=", RowBox[{"Simplify", "[", 
                          RowBox[{"guu", ".", "Pcov"}], "]"}]}], ";", 
                          RowBox[{"Psq", "=", RowBox[{"Simplify", "[", 
                          RowBox[{"Pcov", ".", "Pcon"}], "]"}]}], ";", 
                          RowBox[{"Vsqdd", "=", RowBox[{"Simplify", "[", 
                          RowBox[{"-", RowBox[{"Vdd", ".", "guu", ".", 
                          "Vdd"}]}], "]"}]}], ";", RowBox[{"mixed", "=", 
                          RowBox[{"Simplify", "[", RowBox[{"Pcon", ".", 
                          "Vsqdd", ".", "Pcon"}], "]"}]}], ";", RowBox[
                          {"Simplify", "[", RowBox[{FractionBox["1", "24"], 
                          " ", "prefactor", " ", RowBox[{"(", RowBox[
                          {SuperscriptBox["Vsq", "2"], "-", RowBox[{"4", " ", 
                          "Vfour"}], "+", RowBox[{"4", " ", "Vsq", " ", 
                          "Psq"}], "-", RowBox[{"16", " ", "mixed"}], "-", 
                          RowBox[{"4", " ", SuperscriptBox["Psq", "2"]}]}], 
                          ")"}]}], "]"}]}]}], "]"}]}], ";", RowBox[
                   {"lagVectorScalar", "=", RowBox[{"Simplify", "[", 
                      RowBox[{RowBox[{"vectorInvariantPair", "[", RowBox[
                          {"1", ",", "3", ",", RowBox[{"Xup", 
                          "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}]}], "]"}], "+", RowBox[
                         {"vectorInvariantPair", "[", RowBox[{"2", ",", "3", 
                          ",", RowBox[{"Xup", "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}]}], "]"}]}], "]"}]}], 
                  ";"}]], "Input", InitializationCell -> False, CellLabel -> 
                "In[32]:=", ExpressionUUID -> 
                "06491288-b543-420b-bc6f-72cae8804921"], Cell[CellGroupData[
                {Cell["3.1.1 Fast algebraic regression", "Subsubsection", 
                  ExpressionUUID -> "6dd5ad1c-9304-4f00-9c1d-3650d7d37347"], 
                 Cell["This stage is always executed. It checks the BPS \
algebraic cancellation without invoking the resource-heavy rotating tensor \
simplification.", "Text", ExpressionUUID -> 
                   "ea200ae9-4eb8-4880-8084-3c235aa75201"], Cell[
                  CellGroupData[{Cell[BoxData[RowBox[{RowBox[
                         {"vectorBPSAlgebraCheck", "=", RowBox[{"Expand", 
