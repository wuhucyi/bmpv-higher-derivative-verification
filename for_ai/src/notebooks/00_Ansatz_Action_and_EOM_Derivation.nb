                          {"[", "rho", "]"}], "]"}]}], "]"}], " ", "+", " ", 
                          RowBox[{"D", "[", RowBox[{RowBox[{"gdd", "[", 
                          RowBox[{"[", RowBox[{"aa", ",", "rho"}], "]"}], 
                          "]"}], ",", " ", RowBox[{"coords", "[", RowBox[
                          {"[", "nu", "]"}], "]"}]}], "]"}], " ", "-", " ", 
                          RowBox[{"D", "[", RowBox[{RowBox[{"gdd", "[", 
                          RowBox[{"[", RowBox[{"nu", ",", "rho"}], "]"}], 
                          "]"}], ",", " ", RowBox[{"coords", "[", RowBox[
                          {"[", "aa", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
                          " ", RowBox[{"{", RowBox[{"aa", ",", " ", "dim"}], 
                          "}"}]}], "]"}]}], "]"}], ",", " ", RowBox[{"{", 
                          RowBox[{"mu", ",", " ", "dim"}], "}"}], ",", " ", 
                          RowBox[{"{", RowBox[{"nu", ",", " ", "dim"}], 
                          "}"}], ",", " ", RowBox[{"{", RowBox[{"rho", ",", 
                          " ", "dim"}], "}"}]}], "]"}]}], ";", " ", RowBox[
                         {"RiemUddd", " ", "=", " ", RowBox[{"Table", "[", 
                          RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                          {"D", "[", RowBox[{RowBox[{"GammaUdd", "[", RowBox[
                          {"[", RowBox[{"mu", ",", "nu", ",", "sig"}], "]"}], 
                          "]"}], ",", " ", RowBox[{"coords", "[", RowBox[
                          {"[", "rho", "]"}], "]"}]}], "]"}], " ", "-", " ", 
