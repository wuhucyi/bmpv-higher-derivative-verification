               "Subsection", ExpressionUUID -> 
                "fbc0cc02-8e43-4031-a7f1-dc0eb533775b"], Cell[BoxData[
                RowBox[{RowBox[{RowBox[{"correctedEquation", "[", RowBox[
                       {"field_Symbol", ",", "sectorRules_List"}], "]"}], 
                    ":=", RowBox[{RowBox[{RowBox[{"homogeneousEOM", "[", 
                          "field", "]"}], "+", RowBox[{"gravitySource", "[", 
