                          "[", "correctedEquation", "]"}], "]"}], ">", 
                          "0"}]}], "]"}]}], ";", " ", RowBox[
                   {"actionStageLedger", "=", RowBox[{"<|", RowBox[
                       {RowBox[{"\"LightGeometryAndMatterConstruction\"", 
