                          "\"ResourceBoundByDefault\""}], "]"}]}], "]"}]}], 
                        ";", " ", RowBox[{"fullRotatingVectorStatus", "=", 
                          RowBox[{"Which", "[", RowBox[{RowBox[{"!", RowBox[
                          {"TrueQ", "[", "runResourceHeavyActionChecks", 
                          "]"}]}], ",", "\"SKIPPED/RESOURCE_BOUND\"", ",", 
                          RowBox[{"fullRotatingVectorResult", "===", 
                          "$Aborted"}], ",", "\"RESOURCE_BOUND\"", ",", 
                          RowBox[{"TrueQ", "[", RowBox[{
                          "fullRotatingVectorResult", "===", "0"}], "]"}], 
                          ",", "\"PASS\"", ",", "True", ",", "\"FAIL\""}], 
                          "]"}]}], ";", " ", RowBox[
                         {"vectorInvariantStageRecord", "=", RowBox[{"<|", 
