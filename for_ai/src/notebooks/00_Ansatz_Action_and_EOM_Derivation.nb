                          RowBox[{"4", " ", RowBox[{"(", RowBox[{"2", " ", 
                          RowBox[{"z", "^", "2"}]}], ")"}]}], "+", RowBox[
                          {"4", " ", RowBox[{"(", RowBox[{RowBox[{"-", "2"}], 
