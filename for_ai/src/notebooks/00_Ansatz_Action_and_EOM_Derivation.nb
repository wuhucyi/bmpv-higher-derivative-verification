four-derivative source.", "Text", ExpressionUUID -> 
             "bf5dac5b-e3e4-4d83-b2a7-9404d65b529a"], 
           Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[
                   {"curvatureConstructionCode", "=", RowBox[{"HoldComplete", 
                      "[", RowBox[{RowBox[{"GammaUdd", " ", "=", " ", 
                          RowBox[{"Table", "[", RowBox[{RowBox[{"Simplify", 
                          "[", RowBox[{RowBox[{"(", RowBox[{"1", "/", "2"}], 
                          ")"}], "*", RowBox[{"Sum", "[", RowBox[{RowBox[
                          {RowBox[{"guu", "[", RowBox[{"[", RowBox[{"mu", 
