  Cell[BoxData["literalZeroQ[expr_]:=TrueQ[expr===0]; \
positiveCoefficientPolynomialQ[poly_,vars_]:=Module[{rules,values},rules=Coef\
ficientRules[Expand[poly],vars];values=Last/@rules;Length[values]>0&&And@@(Tr\
ueQ[#>0]&/@values)];\nfullRaw=homGr+srcGr; fullUJets={U1'[x],U2'[x],U3'[x]}; \
fullUJetCoefficients=Coefficient[fullRaw,#]&/@fullUJets; \
fullWithoutUJets=fullRaw/.Thread[fullUJets->0]; \
fullRawJetDecompositionResidual=Expand[fullRaw-fullWithoutUJets-fullUJetCoeff\
icients.fullUJets];\nfullPageRhs=Last/@fullPageRules; \
fullPageReduced=fullWithoutUJets+fullUJetCoefficients.fullPageRhs; \
fullCoefficient=Together[Coefficient[fullPageReduced,Gr[x]]]; \
fullRemainder=fullPageReduced/.Gr[x]->0; \
fullLinearDecompositionResidual=Together[fullPageReduced-fullCoefficient \
Gr[x]-fullRemainder]; fullRule=Gr[x]->-fullRemainder/fullCoefficient; \
fullRuleIdentityResidual=Together[fullCoefficient(Gr[x]/.fullRule)+fullRemain\
der]; \
storedCoefficientDifference=Together[fullCoefficient-storedCoefficient];\nful\
lCoefficientFactored=Factor[fullCoefficient]; \
fullNumerator=Expand[Numerator[fullCoefficientFactored]]; \
fullDenominator=Denominator[fullCoefficientFactored]; \
yPolynomial=Expand[fullNumerator/.jrot^2->y]; \
yDegree=Exponent[yPolynomial,y]; endpoint0=Expand[yPolynomial/.y->0]; \
endpointBMPV=Expand[yPolynomial/.y->q1 q2 q3]; \
endpointPositive={positiveCoefficientPolynomialQ[endpoint0,{q1,q2,q3,x}],posi\
tiveCoefficientPolynomialQ[endpointBMPV,{q1,q2,q3,x}]}; \
denominatorPositiveStructure=MatchQ[Factor[fullDenominator],2(q1+x)^2(q2+x)^2\
(q3+x)^2]; \
fullPhysicalDomainNonzeroProof=TrueQ[yDegree==1&&And@@endpointPositive&&denom\
inatorPositiveStructure];\nfullAudit=<|\"RawElectricJetDecompositionExact\"->\
literalZeroQ[fullRawJetDecompositionResidual],\"PageReducedLinearDecompositio\
nExact\"->literalZeroQ[fullLinearDecompositionResidual],\"RuleIdentityExact\"\
->literalZeroQ[fullRuleIdentityResidual],\"StoredCoefficientMatchesReconstruc\
tion\"->literalZeroQ[storedCoefficientDifference],\"Coefficient\"->fullCoeffi\
cientFactored,\"CoefficientYDegree\"->yDegree,\"EndpointPositiveCoefficientPr\
oofs\"->endpointPositive,\"DenominatorPositiveStructure\"->denominatorPositiv\
eStructure,\"PhysicalExteriorNonzeroProof\"->fullPhysicalDomainNonzeroProof|>\
; expectedFull=<|\"RawElectricJetDecompositionExact\" -> True, \
\"PageReducedLinearDecompositionExact\" -> True, \"RuleIdentityExact\" -> \
