                          " ", "x"}], "+", RowBox[{"29", " ", "q2", " ", 
                          "q3", " ", "x"}], "+", RowBox[{"7", " ", "q1", " ", 
                          SuperscriptBox["x", "2"]}], "+", RowBox[{"7", " ", 
                          "q2", " ", SuperscriptBox["x", "2"]}], "+", RowBox[
                          {"22", " ", "q3", " ", SuperscriptBox["x", 
                          "2"]}]}], ")"}]}], RowBox[{"3", " ", SuperscriptBox[
                        RowBox[{"(", RowBox[{"q1", "+", "x"}], ")"}], "2"], 
                       " ", RowBox[{"(", RowBox[{"q2", "+", "x"}], ")"}], 
                       " ", SuperscriptBox[RowBox[{"(", RowBox[{"q3", "+", 
                          "x"}], ")"}], "2"]}]]}]}], ",", RowBox[{"\"b21\"", 
