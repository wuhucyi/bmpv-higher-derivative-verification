  Cell["Executable master-field completeness check", "Section"], 
  Cell[BoxData["requiredFieldKeys={\"U1\",\"U2\",\"U3\",\"B1\",\"B2\",\"B3\",\
\"P\",\"S\",\"Ft\",\"Gr\",\"K\",\"Om\"}; \
evenFieldKeys={\"U1\",\"U2\",\"U3\",\"P\",\"S\",\"Ft\",\"Gr\",\"K\"}; \
oddFieldKeys={\"B1\",\"B2\",\"B3\",\"Om\"}; \
fieldKeyPass=SubsetQ[Keys[exactSolution],requiredFieldKeys]; \
evenDegreePass=And@@(Exponent[Together[exactSolution[#]],jrot]<=2& /@ \
evenFieldKeys); \
oddDegreePass=And@@(Exponent[Together[exactSolution[#]],jrot]<=3& /@ \
oddFieldKeys); \
staticSeedPresentPass=And@@(FreeQ[Coefficient[Together[exactSolution[#]],jrot\
,0],jrot]& /@ {\"U1\",\"U2\",\"U3\",\"P\",\"S\",\"Ft\",\"Gr\"}); \
masterFormPass=TrueQ[fieldKeyPass&&evenDegreePass&&oddDegreePass&&staticSeedP\
resentPass]; \
<|\"RequiredFieldKeys\"->requiredFieldKeys,\"FieldKeyPass\"->fieldKeyPass,\"E\
venDegreeAtMostTwo\"->evenDegreePass,\"OddDegreeAtMostThree\"->oddDegreePass,\
\"StaticSeedCoefficientsPresent\"->staticSeedPresentPass,\"MasterFormPass\"->\
masterFormPass|>"], "Input"], 
  Cell[BoxData[RowBox[{"masterFormPass", "&&", 
      RowBox[{RowBox[{"orderJ2Validation", "[", 
          "\"AllEightReducedEquationsPass\"", "]"}], "&&", 
        RowBox[{"orderJ2Validation", "[", "\"RadialRulePass\"", "]"}], "&&", 
        RowBox[{"orderJ3Validation", "[", "\"AllFourOddEquationsPass\"", 
          "]"}], "&&", RowBox[{"orderJ4Closure", "[", 
          "\"AllNineEvenEquationsPass\"", "]"}], "&&", 
        RowBox[{"higherOrderClosure", "[", "\"AllHigherOrdersPass\"", 
          "]"}]}]}]], "Input"], Cell["Evidence boundary", "Section"], 
  Cell["Notebook 12, rather than the recorded ledgers here, is the true \
from-EOM verifier for the exact-in-j rotation-dependent coefficients. The \
arbitrary-charge generic static metric coefficient has exact-rational sample \
support but is not promoted to a full symbolic theorem. Page-charge \
conditions and asymptotic decay are exact. The complete generic \
higher-derivative Wald--Tachikawa angular charge, the rotating \
five-to-ten-dimensional heterotic field map, and invariant horizon regularity \
in ingoing co-rotating coordinates remain open.", "Text"]}, 
 WindowTitle -> "Generic BMPV exact-in-j lambda3 correction", 
 StyleDefinitions -> "Default.nb"]
