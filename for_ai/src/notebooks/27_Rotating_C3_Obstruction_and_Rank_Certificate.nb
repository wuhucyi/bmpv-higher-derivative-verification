wrongStageFreeData,\n  wrongStageFixedData} = rankData;\nbaseVariables = \
{cKK,cLower,cQSource,cQuartic,cRh2,cQuadratic,cLinear,\n  \
cHDB,cHBVector,cHAVector,cGDelta,cVarphiDelta,cGTorsion,cVarphiTorsion};\nraw\
Variables = {cRawHh,cRawHz,cRawA1W,cRawA1TStatic,cRawA1TRotation,\n  \
cRawGZ0,cRawGZpStatic,cRawGZpRotation,cRawGW,cRawVarphiZ0,\n  \
cRawVarphiTStatic,cRawVarphiTRotation};\nprofileVariables = \
{cZ0Profile,cWProfile,cTStaticProfile,cTRotationProfile};\nprofileTies = \
<|\"z0\" -> {\"Hh\",\"GZ0\",\"VarphiZ0\"},\n  \"w1\" -> \
{\"Hz\",\"A1W\",\"GW\"},\n  \"Tstatic\" -> \
{\"A1TStatic\",\"GZpStatic\",\"VarphiTStatic\"},\n  \"Trotation\" -> \
{\"A1TRotation\",\"GZpRotation\",\"VarphiTRotation\"}|>;\nprofileTieLedger = \
<|\n  \"FourPrimitiveProfiles\" -> Length[profileTies] == 4,\n  \
\"ThreeDescendantsPerProfile\" -> SameQ[Length /@ Values[profileTies], \
{3,3,3,3}],\n  \"TwelveDistinctRawDescendants\" -> \
DuplicateFreeQ[Flatten[Values[profileTies]]] &&\n    \
Length[Flatten[Values[profileTies]]] == 12|>;\ncertificate[data_, \
variableCount_] := Module[{matrix = data[[1]], rhs = data[[2]],\n    rank, \
augmentedRank}, rank = MatrixRank[matrix];\n  augmentedRank = \
MatrixRank[MapThread[Append, {matrix, rhs}]];\n  <|\"EquationCount\" -> \
Length[matrix], \"VariableCount\" -> variableCount,\n    \"CoefficientRank\" \
-> rank, \"AugmentedRank\" -> augmentedRank,\n    \"Consistent\" -> (rank == \
augmentedRank),\n    \"SolutionDimension\" -> If[rank == augmentedRank, \
variableCount-rank,\n      \"INCONSISTENT\"]|>];\ncertificates = <|\n  \
\"UntiedRawPlusMap\" -> certificate[untiedData, 26],\n  \"Eq331TiedProfiles\" \
-> certificate[tiedData, 18],\n  \"Eq331PhysicalProfiles\" -> \
certificate[physicalData, 14],\n  \"WrongStageFreePredualScalar\" -> \
certificate[wrongStageFreeData, 15],\n  \"WrongStageFixedPredualScalar\" -> \
certificate[wrongStageFixedData, 14]|>;\nrankLedger = <|\n  \
\"UntiedDiagnosticRank14EqualsAugmented14\" ->\n    \
Lookup[certificates[\"UntiedRawPlusMap\"], \
{\"CoefficientRank\",\"AugmentedRank\"}] === {14,14},\n  \
\"UntiedDiagnosticDimension12\" -> \
certificates[\"UntiedRawPlusMap\"][\"SolutionDimension\"] == 12,\n  \
\"TiedProfileInconsistencyRank12To13\" ->\n    \
Lookup[certificates[\"Eq331TiedProfiles\"], \
{\"CoefficientRank\",\"AugmentedRank\"}] === {12,13},\n  \
\"PhysicalProfileInconsistencyRank11To12\" ->\n    \
Lookup[certificates[\"Eq331PhysicalProfiles\"], \
{\"CoefficientRank\",\"AugmentedRank\"}] === {11,12},\n  \
\"WrongStageFreeScalarStillInconsistent\" ->\n    \
Lookup[certificates[\"WrongStageFreePredualScalar\"], \
{\"CoefficientRank\",\"AugmentedRank\"}] === {12,13},\n  \
\"WrongStageFixedScalarStillInconsistent\" ->\n    \
Lookup[certificates[\"WrongStageFixedPredualScalar\"], \
{\"CoefficientRank\",\"AugmentedRank\"}] === \
{11,12}|>;\n\nrawReconstructionAnnotations = <|\"RawMetricLeading\" -> \
\"PASS\",\n  \"RawMetricCorrection\" -> \"PASS\", \"RotatingRawClosureSum\" \
-> \"PASS\",\n  \"StaticRawFieldSum\" -> \"PASS\"|>;\ninterpretation = \
\"untied raw fitting is nonphysical because repeated appearances of each Eq. \
(3.31) primitive profile must inherit one common \
coefficient\";\nlocalizationBoundary = \"the predual rotating chain lacks at \
least one rotation-dependent tensor structure; the present data do not \
localize it uniquely to raw hGeom\";\nledger = Join[conventionLedger, residualLedger, \
profileTieLedger, rankLedger];\nfinalPass = And @@ \
Values[ledger];\nPrint[\"FULL_CHAIN_RESIDUAL_AT_R2 = \", \
InputForm[fullChainResidualAtR2]];\nPrint[\"FULL_CHAIN_CLOSURE_RESIDUAL_AT_R2 \
= \", fullChainClosureResidualAtR2];\nPrint[\"NONZERO_RESIDUAL_TRIPLES = \", \
InputForm[nonzeroResidualTriples]];\nPrint[\"RANK_CERTIFICATES = \", \
InputForm[certificates]];\nPrint[\"STAGE_ANNOTATIONS = \", \
InputForm[stageAnnotations]];\nPrint[\"RAW_RECONSTRUCTION_ANNOTATIONS = \", \
InputForm[rawReconstructionAnnotations]];\nPrint[\"INTERPRETATION = \", \
interpretation];\nPrint[\"LOCALIZATION_BOUNDARY = \", \
